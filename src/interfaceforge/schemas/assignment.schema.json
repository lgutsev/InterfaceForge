{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lgutsev/InterfaceForge/raw/main/schemas/assignment.schema.json",
  "title": "InterfaceForge agentic assignment",
  "description": "Machine-readable specification of a pre-registered agent assignment. Rendered by 'iface assignment render', hashed by 'iface assignment freeze', and used by 'iface assignment validate' to check the agent's report.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "template", "target", "permissions", "tasks", "done_when", "report_back"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "template": {
      "description": "Template name and integer version, e.g. due_diligence@1.",
      "type": "string",
      "pattern": "^[a-z0-9_]+@[0-9]+$"
    },
    "title": {"type": "string", "minLength": 1},
    "prepared": {"description": "Free-text preparation line (date, for whom).", "type": "string"},
    "context": {
      "description": "Background shown above the task block. Judgement-only prose; no criteria live here.",
      "type": "string"
    },
    "evidence_labels": {
      "description": "Evidence-label legend; finding labels in reports must be one of E, P, H, C, S.",
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "commit", "also_read_commits"],
      "properties": {
        "repo": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{7,40}$"},
        "also_read_commits": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[0-9a-fA-F]{7,40}$"}
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "write", "git_allowed", "forbid"],
      "properties": {
        "read": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "write": {
          "description": "Glob patterns. A files_written path must match one. '*' also matches path separators.",
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "git_allowed": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "forbid": {
          "description": "Forbidden locations: a directory prefix, or a glob when it contains * ? or [.",
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "rules": {
      "description": "Extra hard rules appended after the rules generated from permissions.",
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/task"}
    },
    "deliverables": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "done_when": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "report_back": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "unit", "threshold", "rule"],
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "threshold": {"type": ["number", "string"]},
        "rule": {"type": "string", "minLength": 1}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "description", "verdicts", "outputs"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
        "title": {"type": "string", "minLength": 1},
        "kind": {"enum": ["audit", "diag_prepare", "judgement"]},
        "description": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "hypothesis": {"type": "string", "minLength": 1},
        "verdicts": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
        },
        "criterion": {"$ref": "#/$defs/criterion"},
        "outputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "cost": {"enum": ["from_records", "not_inferable"]}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "audit"}}, "required": ["kind"]},
          "then": {"required": ["command"], "not": {"required": ["cost"]}}
        },
        {
          "if": {"properties": {"kind": {"const": "diag_prepare"}}, "required": ["kind"]},
          "then": {"required": ["command", "criterion", "cost"]}
        },
        {
          "if": {"properties": {"kind": {"const": "judgement"}}, "required": ["kind"]},
          "then": {"not": {"anyOf": [{"required": ["command"]}, {"required": ["cost"]}]}}
        }
      ]
    }
  }
}
