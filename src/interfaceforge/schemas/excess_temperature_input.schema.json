{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lgutsev/InterfaceForge/raw/main/schemas/excess_temperature_input.schema.json",
  "title": "InterfaceForge excess-temperature audit input",
  "description": "Input for 'iface audit excess-temperature'. Either one case at the top level, or several independent cases (e.g. one per balanced combination) under 'cases'. gamma = [sum_i c_i E_i - sum_j n_j e_j - dN mu] / D.",
  "type": "object",
  "oneOf": [
    {"$ref": "#/$defs/case", "required": ["interface_frames", "bulk_refs", "denominator_A2"]},
    {
      "type": "object",
      "required": ["cases"],
      "properties": {
        "schema_version": {"const": 1},
        "source": {"type": "object"},
        "notes": {"type": "array", "items": {"type": "string"}},
        "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "case": {
      "type": "object",
      "required": ["interface_frames", "bulk_refs", "denominator_A2"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 1},
        "label": {"type": "string"},
        "source": {"type": "object"},
        "notes": {"type": "array", "items": {"type": "string"}},
        "interface_frames": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "family", "n_atoms", "T_K", "coeff"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "family": {"type": "string", "minLength": 1},
              "n_atoms": {"type": "integer", "minimum": 1},
              "T_K": {"description": "Source MD temperature; null when not recorded.", "type": ["number", "null"]},
              "coeff": {"description": "c_i in the excess formula.", "type": "number"},
              "provenance": {"type": "string"}
            }
          }
        },
        "bulk_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "e_per_fu_eV", "atoms_per_fu", "T_K", "kind", "n_fu_coeff"],
            "additionalProperties": false,
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "e_per_fu_eV": {"type": "number"},
              "atoms_per_fu": {"type": "number", "exclusiveMinimum": 0},
              "T_K": {"type": "number", "minimum": 0},
              "kind": {"enum": ["thermal_mean", "static"]},
              "n_fu_coeff": {"description": "n_j in the excess formula.", "type": "number"},
              "provenance": {"type": "string"}
            }
          }
        },
        "static_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "e_per_fu_eV"],
            "additionalProperties": false,
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "e_per_fu_eV": {"type": "number"},
              "provenance": {"type": "string"}
            }
          }
        },
        "denominator_A2": {
          "description": "D in A^2, including any multiplier such as 2A or 4A.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gamma_values": {
          "description": "Optional per-frame gamma values in J/m^2, grouped by family for the spread check.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["family", "gamma_J_m2"],
            "additionalProperties": false,
            "properties": {
              "frame_id": {"type": "string"},
              "family": {"type": "string", "minLength": 1},
              "gamma_J_m2": {"type": "number"}
            }
          }
        }
      }
    }
  }
}
