# ============================================================
# Step 1: Preheat / forced thermalization
# ============================================================

SYSTEM = Step1_preheat_300K

# ISTART is set by `iface vasp step1-prepare`: 1 when a nonempty OPT WAVECAR
# is inherited for the electronic restart, 0 for a fresh electronic start.
ISTART = 1

# ----------------------------
# Electronic structure (tuned for MD, not a high-accuracy OPT)
# Each MD step reuses the previous step's wavefunction and charge, so the
# SCF loop is short and cheap approximations are fine.
# ----------------------------
ISMEAR = 0
SIGMA  = 0.05
ENCUT  = 400
PREC   = Normal
EDIFF  = 1E-4
NELM   = 60
NELMIN = 4
NELMDL = -5
ALGO   = Fast
LREAL  = Auto
MAXMIX = 40
IVDW   = 11
ISYM   = 0

# ----------------------------
# Molecular dynamics (forced thermalization)
# ----------------------------
IBRION = 0
NSW    = 2000
POTIM  = 1.0

# Thermostat: SMASS=-1 rescales velocities to the target every NBLOCK steps.
# `iface vasp step1-prepare --conservative --langevin` swaps this for a
# Langevin thermostat (MDALGO=3) whose friction also damps a runaway.
SMASS  = -1
NBLOCK = 4
TEBEG  = 300
TEEND  = 300

# Fixed cell; calculate stress
ISIF = 2

# ----------------------------
# Output (keep I/O light during the run)
# ----------------------------
NWRITE = 1
LWAVE  = .TRUE.
LCHARG = .FALSE.

# ----------------------------
# Parallelization (tune NCORE / KPAR to the machine)
# ----------------------------
NCORE = 4

# GGA, ISPIN, LASPH, MAGMOM and the full LDAU* / LMAXMIX block are inherited
# verbatim from each OPT run's INCAR by `iface vasp step1-prepare`.
