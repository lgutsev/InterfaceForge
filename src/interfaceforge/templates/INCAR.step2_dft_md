# ============================================================
# Step 2: Direct DFT-MD for bulk/simple surface MACE data
# Purpose: generate DFT-labeled thermal frames for extxyz/MACE
# ============================================================

SYSTEM = Step2_DFT_MD_300K

# ----------------------------
# Electronic settings
# ----------------------------
ENCUT  = 520
PREC   = Med
ALGO   = Fast
LREAL  = Auto

ISMEAR = 0
#SIGMA  = 0.05

# For TiN, if SCF convergence is annoying, use:
 SIGMA = 0.10

IVDW   = 11
ISYM   = 0

# ----------------------------
# MD settings
# ----------------------------
IBRION = 0
NSW    = 5000
POTIM  = 1.0

MDALGO = 2
SMASS  = 1.0

TEBEG  = 300
TEEND  = 300

ISIF   = 2

# ----------------------------
# Output / trajectory stride
# ----------------------------
NWRITE = 1
NBLOCK = 4
# NSW/NBLOCK here are the academic (5 ps) defaults. `--protocol training`
# overrides NSW to 1000 and thins frames by decorrelation at collection
# time (iface vasp step2-sample), not by NBLOCK.

LWAVE  = .FALSE.
LCHARG = .FALSE.

# ----------------------------
# Parallel settings
# ----------------------------
NCORE  = 1
