{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lgutsev/InterfaceForge/raw/main/schemas/campaign.schema.json",
  "title": "InterfaceForge campaign",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "profile", "reference", "systems", "dataset"],
  "properties": {
    "schema_version": {"const": 1},
    "project": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      },
      "additionalProperties": true
    },
    "profile": {"type": "string", "minLength": 1},
    "reference": {
      "type": "object",
      "required": ["engine"],
      "properties": {
        "engine": {"const": "vasp"},
        "functional": {"type": "string"},
        "inputs": {"type": "object", "additionalProperties": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "systems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "structure"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
          "kind": {
            "enum": ["bulk", "surface", "interface", "molecule", "adsorbate", "other"]
          },
          "structure": {"type": "string", "minLength": 1},
          "temperature": {"type": "number"},
          "tags": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "stages": {"type": "object"},
    "dataset": {
      "type": "object",
      "properties": {
        "strategy": {"enum": ["grouped", "guarded"]},
        "stride": {"type": "integer", "minimum": 1},
        "ratios": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "number", "minimum": 0}
        },
        "guard_frames": {"type": "integer", "minimum": 0},
        "preserve_raw_forces": {"const": true},
        "include_virial": {"type": "boolean"},
        "type_map": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": true
    },
    "models": {"type": "object"},
    "active_learning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "engine": {"const": "ai2kit"},
        "approval_required": {"const": true},
        "max_iterations": {"type": "integer", "minimum": 1},
        "output_root": {"type": "string", "minLength": 1},
        "ai2kit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "workflow": {"enum": ["cll_deepmd", "tesla_mace"]},
            "version": {"const": "1.0.9"},
            "omb_version": {"type": "string", "minLength": 1},
            "executor_name": {"type": "string", "minLength": 1},
            "trainer": {"enum": ["deepmd", "mace"]},
            "explorer": {"enum": ["lammps", "openmm"]},
            "labeler": {"const": "vasp"},
            "selector": {"const": "model_deviation"},
            "architecture": {"enum": ["se_e2_a", "dpa1", "dpa2", "dpa3", "dpa4"]},
            "backend": {"enum": ["tensorflow", "pytorch", "pt_expt"]},
            "model_count": {"type": "integer", "minimum": 1},
            "training_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "validation_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "exploration_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "trust_force_low": {"type": "number", "minimum": 0},
            "trust_force_high": {"type": "number", "exclusiveMinimum": 0},
            "selection_limit": {"type": "integer", "minimum": 1},
            "experimental_compatibility": {"type": "boolean"},
            "committee_models": {
              "type": "array",
              "minItems": 2,
              "items": {"type": "string", "minLength": 1}
            },
            "committee_seeds": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {"type": "integer"}
            },
            "md_steps": {"type": "integer", "minimum": 1},
            "sample_frequency": {"type": "integer", "minimum": 1},
            "timestep_fs": {"type": "number", "exclusiveMinimum": 0},
            "friction_ps": {"type": "number", "exclusiveMinimum": 0},
            "equilibration_frames": {"type": "integer", "minimum": 0},
            "max_force_ev_ang": {"type": "number", "exclusiveMinimum": 0},
            "default_dtype": {"enum": ["float32", "float64"]},
            "use_poor_frames": {"type": "integer", "minimum": 0},
            "update_md_structures": {"type": "integer", "minimum": 0},
            "md_workers": {"type": "integer", "minimum": 1},
            "label_workers": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "exploration": {"type": "object"},
    "validation": {"type": "object"}
  }
}
